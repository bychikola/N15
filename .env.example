# ============================================================
# N15 — переменные окружения
# Локальная разработка (.env.local): NEXT_PUBLIC_* + опционально PAYLOAD_SECRET
# Docker на VPS (.env рядом с docker-compose.yml): все переменные
# ============================================================

# --- Yandex Maps (JS API) ---
# Публичный по дизайну (встраивается в клиентский скрипт карты).
# Используется для отрисовки карты и геокодирования адреса (ymaps.geocode).
# Получение: https://developer.tech.yandex.ru → «JavaScript API».
# В ограничениях (HTTP Referers): localhost и ваш домен.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=your_yandex_maps_js_api_key_here

# --- Сайт ---
# Публичный URL (инлайнится в bundle при сборке).
NEXT_PUBLIC_SERVER_URL=https://n15.ru

# --- Payload / база данных ---
# Секрет для подписи JWT/сессий. Сгенерируйте: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-random-32-plus-hex-chars

# Строка подключения к PostgreSQL (Docker/prod). Если не задана — используется локальный SQLite (n15.db).
DATABASE_URI=postgres://n15:<password>@postgres:5432/n15

# --- PostgreSQL (для docker-compose) ---
POSTGRES_DB=n15
POSTGRES_USER=n15
POSTGRES_PASSWORD=change-me-strong-password
